{
  "name": "signal-notes",
  "version": "0.1.0",
  "description": "A Bun-native public research desk for curated tools, AI workflows, sources, and field notes.",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun --watch src/server.tsx",
    "start": "bun src/server.tsx",
    "build": "bun build src/server.tsx --target=node --outdir=dist --production --external react --external react-dom",
    "generate:og": "bun scripts/generate-og.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun test && tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.7.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
